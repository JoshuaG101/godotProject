[sub_resource type="GDScript" id="GDScript_58a12"]
script/source = "extends CharacterBody3D

const SPEED = 3.0
var gravity = ProjectSettings.get_setting(\"physics/3d/default_gravity\")
@export var direction := Vector3(-1, 0, 0)
@export var max_health := 100.0
@onready var health_bar = $Healthbar/SubViewport/CustomHealthBar

var current_health: float = max_health
var turning := false
var is_grabbed := false

# Knockback variables
var knockback_velocity := Vector3.ZERO
var knockback_decay := 10.0 # How quickly the enemy stops sliding after a hit

func _ready():
	current_health = max_health
	add_to_group(\"enemy\")
	
	# Initialize the health bar sizes
	if health_bar:
		health_bar._setup_health_bar(max_health)

func _physics_process(delta):
	if is_grabbed: return 
	
	# Start with base patrol movement
	var current_velocity = direction * SPEED

	# --- APPLY KNOCKBACK INFLUENCE ---
	if knockback_velocity.length() > 0.1:
		current_velocity += knockback_velocity
		# Gradually bleed off knockback speed over time across all axes
		knockback_velocity = knockback_velocity.move_toward(Vector3.ZERO, knockback_decay * delta)

	# Apply gravity smoothly
	if not is_on_floor():
		velocity.y -= gravity * delta
	else:
		# If grounded, reset any leftover downward knockback forces
		if knockback_velocity.y < 0:
			knockback_velocity.y = 0

	# Combine movement tracks into physical velocity
	velocity.x = current_velocity.x
	velocity.z = current_velocity.z
	if current_velocity.y != 0:
		velocity.y += current_velocity.y

	move_and_slide()

	if is_on_wall() and not turning:
		turn_around()

func take_damage(amount: float, knockback_vector: Vector3):
	if is_grabbed: return
	
	current_health -= amount
	print(\"Enemy took \", amount, \" damage! Current HP: \", current_health)
	
	# Update the health bar UI and trigger the fade-in tween
	if health_bar:
		health_bar.change_value(current_health)
	
	knockback_velocity = knockback_vector
	
	if current_health <= 0:
		die()

func die():
	print(\"Enemy died!\")
	queue_free()

func turn_around():
	turning = true
	var dir = direction
	direction = Vector3.ZERO
	var turn_tween = create_tween()
	turn_tween.tween_property(self, \"rotation_degrees\", Vector3(0, 180, 0), 0.6).as_relative()
	await get_tree().create_timer(0.6).timeout
			
	direction.x = dir.x * -1
	direction.z = dir.z * -1
	turning = false

# --- Grabbing System ---
func grab():
	is_grabbed = true
	set_physics_process(false)
	if has_node(\"CollisionShape3D\"):
		$CollisionShape3D.disabled = true
	print(\"Enemy: I have been grabbed!\")

func throw(force: Vector3):
	is_grabbed = false
	set_physics_process(true)
	if has_node(\"CollisionShape3D\"):
		$CollisionShape3D.disabled = false
	velocity = force
	print(\"Enemy: I have been thrown!\")

func _on_top_checker_body_entered(body: Node3D) -> void:
	if body.has_method(\"bounce\"):
		body.bounce()
"

